{
  "devices": [
    {
      "type": "VCUController",
      "device_id": "VCU-0",
      "address": 0,
      "port": "COM6",
      "baudrate": 19200,
      "bytesize": 8,
      "parity": "N",
      "stopbits": 1,
      "timeout": 1.0,
      "write_timeout": 1.0,
      "reconnect_interval": 3.0,
      "max_retries": 5,
      "number of pressure sensors": 3,
      "poll_interval": 0.5
    }
  ],
  "logging": {
    "enabled": true,
    "directory": "logs",
    "rotation_enabled": true
  },
  "gui": {
    "theme": "dark",
    "window": {
      "width": 1280,
      "height": 800,
      "x": 100,
      "y": 100,
      "maximized": false
    },
    "plots": [
      {
        "device_id": "VCU-0",
        "dock_id": "plot_VCU-0",
        "title": "VCU-0 Pressure",
        "area": "right",
        "channels": [
          "ch1_pressure",
          "ch2_pressure"
        ],
        "colours": [
          "#00bfff",
          "#ff6b6b"
        ],
        "history_seconds": 60.0
      }
    ],
    "device_panels": [
      {
        "device_id": "VCU-0",
        "dock_id": "device_VCU-0",
        "area": "left"
      }
    ]
  }
}